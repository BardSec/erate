# Flask
FLASK_ENV=development
SECRET_KEY=changeme
ALLOW_LOCAL_AUTH=true

# Database
DATABASE_URL=postgresql://erate:erate@db:5432/erate_manager

# Tenancy
SUBDOMAIN_TENANCY=false

# Cloudflare R2
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=erate-documents

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Encryption key for storing OIDC secrets (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=

# Platform admin (used by flask init-db)
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=changeme
