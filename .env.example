# Flask
# IMPORTANT: Generate a real secret key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme
FLASK_DEBUG=0
ALLOW_LOCAL_AUTH=false

# Database
# IMPORTANT: Use a strong password in production
POSTGRES_USER=erate
POSTGRES_PASSWORD=changeme-use-a-strong-password
POSTGRES_DB=erate_manager
DATABASE_URL=postgresql://erate:changeme-use-a-strong-password@db:5432/erate_manager

# Tenancy
SUBDOMAIN_TENANCY=false

# Session security (set to false only for local dev without HTTPS)
SESSION_COOKIE_SECURE=true

# Proxy trust level (1 for Cloudflare Tunnel, 0 for direct access in dev)
PROXY_TRUST_LEVEL=1

# Cloudflare R2
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=erate-documents

# Cloudflare Tunnel
# Required — the tunnel token from your Cloudflare Zero Trust dashboard
# Configure the tunnel to route traffic to http://app:8000
CLOUDFLARE_TUNNEL_TOKEN=

# Encryption key for storing OIDC secrets at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Platform admin (used by flask init-db)
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=changeme
